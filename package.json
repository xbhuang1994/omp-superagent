{
  "name": "omp-superagent",
  "author": "DeepSeek Harness Team <team@dsh.dev>",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "description": "A standalone OMP agent for one GitHub repository: evaluates authorized requests and executes each Ticket in a persistent worker Session.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "omp-superagent": "./lib/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "prompts",
    "skills"
  ],
  "scripts": {
    "start": "bun lib/cli.js",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "bun run --bun vitest run",
    "check": "bun run typecheck && bun run test && bun run build"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "dependencies": {
    "@oh-my-pi/pi-coding-agent": "18.18.1",
    "proper-lockfile": "4.1.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "@types/proper-lockfile": "4.1.4",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
